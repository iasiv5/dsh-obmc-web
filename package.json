{
  "name": "@iasiv5/dsh-obmc-web",
  "version": "0.1.1",
  "description": "OpenBMC 控制台入口：设置一级菜单「BMC 控制台」面板一键在顶层标签页打开 BMC Web UI，同源代理经 SSH 本地转发 relay（obmc-web-relay）抵达 BMC，BMC IP 变化自动探测并重定向隧道；需 SSH 跳板机可达 BMC。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "deploy/",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "iasiv5",
  "homepage": "https://github.com/iasiv5/dsh-obmc-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iasiv5/dsh-obmc-web.git"
  },
  "bugs": {
    "url": "https://github.com/iasiv5/dsh-obmc-web/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "openbmc",
    "bmcweb",
    "redfish",
    "same-origin-proxy",
    "settings-section"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
