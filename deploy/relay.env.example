# @iasiv5/dsh-obmc-web / obmc-web-relay shared configuration.
# Location: ~/.config/systemd/user/obmc-relay.env (the plugin side can be
# moved anywhere with the OBMC_WEB_ENV env var). KEY=VALUE lines; keys the
# plugin or the relay unit do not know are ignored.
#
# The plugin reads this file at dsh web startup; changes require a restart.

# Current BMC address (ip:port). Consumed by the relay unit's ExecStart and
# rewritten in place by the plugin's SSH discovery. 192.0.2.x are
# documentation addresses — replace with your BMC's.
BMC_TARGET=192.0.2.10:443

# ---- Optional: SSH auto-discovery ---------------------------------------
# With these set, when the tunnel stops answering the plugin SSHes to the
# jump host (BatchMode key expected to be already authorized) and re-locates
# the bmcweb speaker on the link subnet: dnsmasq leases + ARP table first,
# full TCP-443 sweep as fallback. Without them the proxy still works — it
# just cannot retarget itself.
OBMC_SSH_TARGET=user@jump.example.net
OBMC_SSH_PORT=22
# Link subnet to sweep; defaults to the BMC target IP's /24 when omitted.
OBMC_SUBNET=192.0.2
